{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyLay",
  "version": "0.1.0",
  "identifier": "dev.yoma.keylay",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "KeyLay",
        "url": "index.html",
        "width": 460,
        "height": 440,
        "minWidth": 400,
        "minHeight": 160,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "popover",
            "acrylic"
          ],
          "state": "active",
          "radius": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Active layer, battery and keymap cheat sheet for QMK and ZMK keyboards",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
